# Non-secret runtime knobs only. Secrets never go in env files or the
# environment — they live in the one secrets file described in SECURITY.md.

# Path to the secrets file (default: ~/.config/gridbot/secrets.env, or
# $CREDENTIALS_DIRECTORY/gridbot-secrets under systemd LoadCredential=)
#GRIDBOT_SECRETS_FILE=

# Extra GRID titles once confirmed by scripts/grid_probe.py, e.g. "lol=3,dota2=4"
#GRIDBOT_EXTRA_TITLES=

# Override the capture data directory (default: <repo>/data)
#GRIDBOT_DATA_DIR=
