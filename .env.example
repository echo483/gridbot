# gridbot keeps NO secrets in env files — secrets live in the OS keyring
# (service "gridbot"), written by: uv run python scripts/setup_secrets.py
# See SECURITY.md. The variables below are non-secret runtime knobs only.

# Extra GRID titles once confirmed by scripts/grid_probe.py, e.g. "lol=3,dota2=4"
#GRIDBOT_EXTRA_TITLES=

# Override the capture data directory (default: <repo>/data)
#GRIDBOT_DATA_DIR=
