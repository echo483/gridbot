# Copy to .env (gitignored). Prefer the system keyring for GRID; .env is the fallback.

# GRID Open Access — only if not using the keyring entry
GRID_API_KEY=

# OpenRouter "gridbot" workspace key — consumed by hermes (slow-loop agents),
# set there via `hermes model` / config; kept here only if gridbot calls OpenRouter directly
OPENROUTER_API_KEY=

# --- P2 (live arming) only — leave empty until an instrument passes ---
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
