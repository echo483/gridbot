# gridbot weekly deep analysis — oneshot, fired by gridbot-managed-analysis.timer.
# Runs one budget-capped ($5) session of the Claude Managed Agent in its
# hermetic sandbox (no egress) over freshly gathered evidence. Slow loop:
# drafts only. Needs the unlocked keyring (ANTHROPIC_API_KEY).
[Unit]
Description=gridbot weekly managed-agent deep analysis (slow loop; drafts only)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ops/gridbot
ExecStart=/home/ops/.local/bin/uv run python -m gridbot.analysis.managed
TimeoutStartSec=2100
NoNewPrivileges=true
