# gridbot raw backup — oneshot, fired daily by gridbot-backup.timer.
# Uploads finished capture day files (gzipped) to the private Supabase
# Storage bucket. The corpus moat gets an offsite copy.
[Unit]
Description=gridbot raw-capture offsite backup (Supabase Storage)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ops/gridbot
ExecStart=/home/ops/.local/bin/uv run python scripts/backup_raw.py
NoNewPrivileges=true
