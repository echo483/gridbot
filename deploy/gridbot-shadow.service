# gridbot shadow engine — READ-ONLY hypothesis instrument recorder.
#
# Tails capture day files, detects registered trigger states (H-MANADV1,
# H-ECONBUY1, H-PISTOLCARRY1), records hypothetical entries + time-aligned
# book tops to data/shadow/. Places NO orders, holds NO keys, calls no LLM.

[Unit]
Description=gridbot shadow engine (hypothesis instance recorder; no trading)
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=/home/ops/gridbot
ExecStart=/home/ops/.local/bin/uv run python -m gridbot.instruments.shadow
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=15
NoNewPrivileges=true

[Install]
WantedBy=default.target
