# gridbot morning report — oneshot, fired daily at 08:00 by gridbot-morning.timer.
# Deterministic overnight digest: local files + systemctl only, no model calls.
# The ONE message the operator wakes to. Delivery via gridbot.notify
# (GRIDBOT_NOTIFY_WEBHOOK); without it configured, stdout only.
[Unit]
Description=gridbot consolidated morning digest

[Service]
Type=oneshot
WorkingDirectory=/home/ops/gridbot
ExecStart=/home/ops/.local/bin/uv run python scripts/morning_report.py --send
NoNewPrivileges=true
