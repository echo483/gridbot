# gridbot morning report — oneshot, fired daily at 08:00 by gridbot-morning.timer.
# Deterministic overnight digest (no LLM, local files + systemctl only),
# delivered to Telegram via hermes send. The ONE message the user wakes to.
[Unit]
Description=gridbot consolidated morning digest (Telegram)

[Service]
Type=oneshot
WorkingDirectory=/home/ops/gridbot
ExecStart=/home/ops/.local/bin/uv run python scripts/morning_report.py --send
NoNewPrivileges=true
