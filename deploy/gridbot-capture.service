# gridbot capture — unattended esports data collection (GRID + Polymarket books).
#
# READ-ONLY: collects data only. Places NO orders, never arms, has no trading
# surface, makes no edge/ROI claim.
#
# GRID_API_KEY comes from the secrets file (gridbot.config; SECURITY.md), so the
# unit no longer depends on a desktop session: it starts at boot with linger.

[Unit]
Description=gridbot capture (READ-ONLY GRID + Polymarket data collection; no trading)
Documentation=file:///home/ops/gridbot/SECURITY.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=/home/ops/gridbot
# Non-secret runtime knobs (e.g. GRIDBOT_EXTRA_TITLES after the title probe).
# NEVER put a secret here — secrets live in the secrets file only.
EnvironmentFile=-/home/ops/gridbot/deploy/capture.env
# systemd-inhibit: while capture runs, block IDLE suspend (KDE's 2h AC
# auto-suspend put the box to sleep 03:28–14:17 on 2026-08-25 and cost 10.8h
# of capture). Manual suspend still works — the user sees who blocks and why.
ExecStart=/usr/bin/systemd-inhibit --what=sleep --who=gridbot-capture "--why=GRID capture continuity (corpus moat)" --mode=block /home/ops/.local/bin/uv run python -m gridbot.capture.supervisor
# Graceful stop: SIGTERM the supervisor only; it drains and flushes writers.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=on-failure
RestartSec=15
NoNewPrivileges=true

[Install]
WantedBy=default.target
